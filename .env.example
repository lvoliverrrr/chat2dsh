# Copy to .env and fill in. Loaded by `npm start` / `npm run stdio` via node --env-file-if-exists.

# --- auth -------------------------------------------------------------------
# Required in HTTP mode. The server refuses to start without it unless you pass --no-auth.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CHAT2DSH_TOKEN=

# --- workspace roots --------------------------------------------------------
# Only these directories (and their subdirectories) may be handed to dsh as cwd.
# Separate with ; on Windows, : on macOS/Linux. On Windows use forward slashes.
# Example: CHAT2DSH_ROOTS=C:/Users/me/projects/demo;D:/work/api
CHAT2DSH_ROOTS=

# --- binding ----------------------------------------------------------------
CHAT2DSH_HOST=127.0.0.1
CHAT2DSH_PORT=7317
CHAT2DSH_PATH=/mcp

# --- deepseek harness -------------------------------------------------------
CHAT2DSH_DSH_PROFILE=headless
# Explicit JS entry, if auto-discovery picks the wrong install:
# CHAT2DSH_DSH_ENTRY=C:/Users/me/.workbuddy/binaries/node/versions/22.22.2-6/node_modules/@deepseek-ai/dsh/lib/bin.js
# Command used only when the JS entry cannot be resolved (runs through a shell):
CHAT2DSH_DSH_BIN=dsh
CHAT2DSH_TIMEOUT_MS=300000
CHAT2DSH_MAX_OUTPUT=65536

# --- credentials passed to the dsh child process -----------------------------
# Optional. If DSH already stores its key (~/.dsh/.credentials.yaml), leave these empty.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=
